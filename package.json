{
  "name": "agi-super-team",
  "version": "1.7.0",
  "description": "Evidence-backed AI team packs with preview-first installation and repository contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aAAaqwq/AGI-Super-Team.git"
  },
  "homepage": "https://github.com/aAAaqwq/AGI-Super-Team#readme",
  "bugs": {
    "url": "https://github.com/aAAaqwq/AGI-Super-Team/issues"
  },
  "type": "module",
  "bin": {
    "agi-super-team": "bin/agi-super-team.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".cursor-plugin/plugin.json",
    ".kimi-plugin/plugin.json",
    ".codex/INDEX.md",
    "gemini-extension.json",
    "config/cli-adapters.json",
    "config/cli-adapters.schema.json",
    "config/harness-adapters/",
    "config/agent-hierarchy.json",
    "config/agent-hierarchy.schema.json",
    "config/agent-sources.lock.json",
    "config/*-specialists.json",
    "config/specialist-routing.schema.json",
    "config/team-manifest.json",
    "plugins/README.md",
    "plugins/agi-super-team-codex/.codex-plugin/plugin.json",
    "plugins/agi-super-team-codex/payload/",
    "plugins/agi-super-team-codex/README.md",
    "plugins/agi-super-team-codex/THIRD_PARTY_NOTICES.md",
    "plugins/agi-super-team-codex/skills/*/SKILL.md",
    "plugins/agi-super-team-codex/skills/*/agents/**",
    "plugins/agi-super-team-codex/skills/*/references/**",
    "plugins/agi-super-team-codex/skills/*/scripts/*.py",
    "plugins/agi-super-team-claudecode/**",
    "plugins/agi-super-team-hermes/**",
    "plugins/agi-super-team-dsh/**",
    "plugins/agi-super-team-openclaw/**",
    "skills/",
    "LICENSE",
    "README.md",
    "README_CN.md",
    "README.es-ES.md",
    "docs/assets/logo-intelligence.webp",
    "docs/assets/team-intelligence.webp",
    "docs/assets/team-workflow.svg",
    "docs/assets/team-workflow-zh.svg",
    "docs/assets/team-workflow-es.svg",
    "docs/guides/npm-release-status.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm test && npm run validate:strict && git diff --check",
    "test": "npm run test:repository && npm run test:installer && npm run check:subagent-sources && npm run check:agent-indexes && npm run check:codex-team && npm run check:harness-packages && npm run check:skills && npm run check:skill-quality && npm run check:taxonomy-evaluation && npm run check:architecture",
    "test:site": "python3 -m unittest -v tests.test_site_contracts tests.test_site_data tests.test_official_stars_contract tests.test_readme_contracts",
    "test:repository": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:windows-cli": "node tests/windows_cli_smoke.mjs",
    "test:installer": "bash tests/installer/test_install.sh",
    "validate": "python3 scripts/validate_repository.py",
    "validate:strict": "python3 scripts/validate_repository.py --warnings-as-errors",
    "build:agent-indexes": "python3 scripts/build_agent_skill_indexes.py",
    "check:agent-indexes": "python3 scripts/build_agent_skill_indexes.py --check",
    "build:subagent-sources": "python3 scripts/build_executive_subagent_sources.py",
    "check:subagent-sources": "python3 scripts/build_executive_subagent_sources.py --check",
    "build:codex-team": "python3 scripts/build_codex_csuite_adapter.py",
    "check:codex-team": "python3 scripts/build_codex_csuite_adapter.py --check",
    "build:harness-packages": "python3 scripts/check_harness_packages.py",
    "check:harness-packages": "python3 scripts/check_harness_packages.py --check",
    "build:skills": "python3 scripts/build_skill_catalog.py && python3 scripts/build_original_skills_index.py",
    "check:skills": "python3 scripts/build_skill_catalog.py --check && python3 scripts/build_original_skills_index.py --check",
    "build:original-skills": "python3 scripts/build_original_skills_index.py",
    "check:original-skills": "python3 scripts/build_original_skills_index.py --check",
    "build:skill-quality": "python3 scripts/audit_skill_quality.py",
    "check:skill-quality": "python3 scripts/audit_skill_quality.py --check",
    "build:taxonomy-evaluation": "python3 scripts/build_skill_taxonomy_evaluation.py",
    "check:taxonomy-evaluation": "python3 scripts/build_skill_taxonomy_evaluation.py --check",
    "check:architecture": "python3 scripts/audit_architecture.py --check"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "skills",
    "c-suite",
    "multi-agent"
  ]
}
