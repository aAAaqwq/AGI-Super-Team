{
  "$schema": "./intent-routing.schema.json",
  "schemaVersion": 1,
  "policy": "先按任务意图选择主责 C-suite；只有跨两个以上领域、需要资源与优先级取舍，或需要最终综合决策时才升级到 CEO。禁止用 CTO 作为默认兜底。",
  "routes": [
    {
      "intent": "产品方向、用户问题、需求边界、优先级、体验与可访问性",
      "primary": "cpo",
      "supporting": ["cro", "cto"],
      "keywords": ["产品", "需求", "用户", "体验", "优先级", "功能范围", "PRD", "可用性", "信息架构"]
    },
    {
      "intent": "技术战略、架构边界、接口/API、技术选型、性能与可靠性",
      "primary": "cto",
      "supporting": ["pe", "cdo"],
      "keywords": ["架构", "技术选型", "API", "接口", "可靠性", "性能", "故障复盘", "系统设计", "平台成本"]
    },
    {
      "intent": "已批准设计的跨模块实现、集成、测试、评审与可回退交付",
      "primary": "pe",
      "supporting": ["cto"],
      "keywords": ["实现", "编码", "集成", "测试", "重构", "缺陷修复", "交付", "代码评审"]
    },
    {
      "intent": "量化假设、回测、模型评估、策略与组合风险",
      "primary": "cqo",
      "supporting": ["cdo", "cfo"],
      "keywords": ["量化", "回测", "策略", "因子", "模型评估", "组合风险", "交易信号", "A股", "选股"]
    },
    {
      "intent": "市场定位、品牌、获客、投放、SEO 与归因",
      "primary": "cmo",
      "supporting": ["cco", "cro"],
      "keywords": ["品牌", "获客", "投放", "广告", "SEO", "定位", "增长实验", "归因", "渠道"]
    },
    {
      "intent": "预算、单位经济、定价证据、资本配置与成本",
      "primary": "cfo",
      "supporting": ["cpo", "cqo"],
      "keywords": ["预算", "定价", "单位经济", "成本", "现金流", "融资", "资本配置", "财务预测"]
    },
    {
      "intent": "数据契约、口径、质量、血缘、指标体系与分析模型",
      "primary": "cdo",
      "supporting": ["cro", "cto"],
      "keywords": ["数据口径", "指标", "数据质量", "血缘", "数据治理", "分析模型", "报表", "数据安全"]
    },
    {
      "intent": "内容策略、选题、脚本结构、平台适配与制作编排",
      "primary": "cco",
      "supporting": ["cmo", "cro"],
      "keywords": ["内容", "选题", "脚本", "短视频", "公众号", "小红书", "抖音", "B站", "编辑简报", "平台适配"]
    },
    {
      "intent": "合同、隐私、跨境合规、许可、知识产权与监管",
      "primary": "clo",
      "supporting": ["cdo", "cfo"],
      "keywords": ["合同", "隐私", "合规", "许可", "知识产权", "监管", "条款", "数据跨境"]
    },
    {
      "intent": "研究问题设计、一手证据、竞品与市场情报、多源核验",
      "primary": "cro",
      "supporting": ["cdo", "cco"],
      "keywords": ["研究", "证据", "竞品", "情报", "调研", "核验", "市场扫描", "事实核查"]
    },
    {
      "intent": "客户发现、资格审查、赢单策略、方案叙事与销售管道",
      "primary": "cso",
      "supporting": ["cpo", "cfo"],
      "keywords": ["销售", "客户", "商机", "赢单", "投标", "方案", "管道", "续约", "客户成功"]
    },
    {
      "intent": "运营计划、责任与依赖、SOP、产能、排期与异常恢复",
      "primary": "coo",
      "supporting": ["cpo", "cfo"],
      "keywords": ["运营", "SOP", "流程", "排期", "产能", "跨部门", "执行节奏", "责任矩阵", "异常恢复"]
    },
    {
      "intent": "重大结论、发布、资金、法律、安全或完成声明的独立复核",
      "primary": "governor",
      "supporting": [],
      "keywords": ["复核", "放行", "审计", "风险升级", "完成声明", "发布前检查", "独立验证"]
    }
  ],
  "escalation": {
    "primary": "ceo",
    "when": [
      "任务同时覆盖两个以上 C-suite 领域，且需要取舍或统一交付",
      "需要在稀缺资源、预算、范围与时间之间做公司级决策",
      "多个 C-suite 结论冲突，需要综合并保留异议",
      "用户明确要求 CEO 或公司级团队"
    ],
    "keywords": ["公司级", "跨职能", "资源取舍", "多团队", "最终决策", "路线图", "战略"]
  },
  "fallback": "意图仍不明确时先提出一个澄清问题；不要默认调用 CTO，也不要在没有跨领域证据时启动 CEO。"
}
